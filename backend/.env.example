# Copy to .env for local development
NODE_ENV=development
PORT=8000
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=5432
DB_USER=ecamarao
DB_PASSWORD=ecamarao
DB_NAME=ecamarao
DB_SYNCHRONIZE=true

JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1d

# Initial admin seeded on first boot (when the users table is empty)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin@ecamarao.local
SEED_ADMIN_NAME=Administrador
