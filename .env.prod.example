# Copy to .env on the production host and fill in real values.
# docker compose -f docker-compose.prod.yml --env-file .env up -d --build

# Database credentials (used by both postgres and backend services)
DB_USER=ecamarao
DB_PASSWORD=change-me-strong-password
DB_NAME=ecamarao

# JWT signing secret — generate with: openssl rand -hex 48
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=1d

# Initial admin seeded on first boot (when the users table is empty)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin@ecamarao.local

# CORS_ORIGIN — comma-separated list of allowed origins for direct API access
# (e.g. the mobile apps). Leave empty while the web app only talks to the API
# through nginx's same-origin /api proxy. Example:
# CORS_ORIGIN=https://ecamarao.example.com
CORS_ORIGIN=

# TypeORM auto-sync. Keep "true" for MVP/initial boot to create tables; once
# proper migrations are introduced, switch to "false" to avoid schema drift.
DB_SYNCHRONIZE=true
